MONGODB_CONNECTION_STRING=mongodb+srv://<username>:<password>@<mongo-cluster-url>/<database>?retryWrites=true&w=majority
PORT=3000
SECRET=<jwt-secret>
NODE_OPTIONS=--openssl-legacy-provider

# Google OAuth
GOOGLE_CLIENT_ID=<google-client-id>.apps.googleusercontent.com
CLIENT_ID=<google-oauth-client-id>.apps.googleusercontent.com
CLIENT_SECRET=<google-oauth-client-secret>
ACCESS_TOKEN=<google-access-token>
REFRESH_TOKEN=<google-refresh-token>

# URLs
REACT_APP_BACKEND_URL=<backend-url>
REACT_APP_GRAPHQL_URL=<backend-url>/graphql
REACT_APP_GRAPHQL_WS_URL=<backend-url>/graphql
REACT_APP_SERVICE_URL=<service-url>/auth

# Redis
REDIS_HOST=<redis-host>
REDIS_PORT=6379
REDIS_USERNAME=<redis-username>
REDIS_PASSWORD=<redis-password>

# Email (SendGrid)
SENDER_EMAIL=example@example.com
SENDER_EMAIL_PASSWORD=<sender-email-password>
SENDGRID_API_KEY=<sendgrid-api-key>
REMINDER_MAIL_ID=<sendgrid-reminder-template-id>
UPDATE_MAIL_ID=<sendgrid-update-template-id>

# Twilio
TWILIO_ACCOUNT_SID=<twilio-account-sid>
TWILIO_AUTH_TOKEN=<twilio-auth-token>
TWILIO_PHONE_NUMBER=<twilio-phone-number>